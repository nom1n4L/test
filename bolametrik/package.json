{
  "name": "bolametrik",
  "private": true,
  "version": "1.0.0",
  "description": "BolaMetrik — aplikasi prediksi sepak bola berbasis model statistik (Poisson/Dixon-Coles) yang belajar dari hasil pertandingan.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/make-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
